#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Block NEW .env files. The repo intentionally tracks a few templates
# (.env.example, .env.dev, .env.tests, .env.e2e); those carry no secrets and
# have to stay editable. Anything not already in HEAD is treated as a leak.
NEW_ENV_FILES=$(git diff --cached --name-only --diff-filter=A | grep '\.env' || true)
if [ -n "$NEW_ENV_FILES" ]; then
  echo "Error: Attempting to commit new .env files:"
  echo "$NEW_ENV_FILES"
  echo "Please unstage them with: git reset HEAD <file>"
  exit 1
fi
