    "test": "vitest run"
  },
  "dependencies": {
    "@fema-ipaas/connector-common": "workspace:*",
    "@fema-ipaas/connector-sdk": "workspace:*",
    "zod": "4.3.6",
    "@fema-ipaas/connector-types": "workspace:*",
    "@fema-ipaas/core-utils": "workspace:*"
  },
  "devDependencies": {
    "vitest": "3.2.6",
    "tslib": "2.6.2"
  }
}
