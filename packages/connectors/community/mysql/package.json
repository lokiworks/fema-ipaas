{
  "name": "@fema-ipaas/connector-mysql",
  "version": "0.3.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "dependencies": {
    "@fema-ipaas/connector-common": "workspace:*",
    "@fema-ipaas/connector-sdk": "workspace:*",
    "promise-mysql": "5.2.0",
    "sqlstring": "2.3.3",
    "@fema-ipaas/connector-types": "workspace:*",
    "@fema-ipaas/core-utils": "workspace:*",
    "tslib": "2.6.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && cp package.json dist/ && mkdir -p dist/src/i18n && cp src/i18n/*.json dist/src/i18n/",
    "bundle": "node ../../../../dist/packages/cli/src/index.js connectors bundle",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/sqlstring": "2.3.2",
    "vitest": "3.2.6"
  }
}
