{
  "name": "@fema-ipaas/connector-math-helper",
  "version": "0.0.30",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bundleDeps": true,
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && cp package.json dist/ && mkdir -p dist/src/i18n && cp src/i18n/*.json dist/src/i18n/",
