## It's advisable to consult the documentation and use the tools/deploy.sh to generate the passwords, keys, instead of manually filling them.

FEMA_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js

## Random Long Password (Optional for community edition)
FEMA_API_KEY=

## 256 bit encryption key, 32 hex character
FEMA_ENCRYPTION_KEY=

## JWT Secret
FEMA_JWT_SECRET=

FEMA_ENVIRONMENT=prod
FEMA_FRONTEND_URL=http://localhost:8080
FEMA_WEBHOOK_TIMEOUT_SECONDS=30
FEMA_TRIGGER_DEFAULT_POLL_INTERVAL=5
FEMA_POSTGRES_DATABASE=activepieces
FEMA_POSTGRES_HOST=postgres
FEMA_POSTGRES_PORT=5432
FEMA_POSTGRES_USERNAME=postgres
FEMA_POSTGRES_PASSWORD=
FEMA_EXECUTION_MODE=UNSANDBOXED
FEMA_REDIS_HOST=redis
FEMA_REDIS_PORT=6379
FEMA_FLOW_TIMEOUT_SECONDS=600
FEMA_TELEMETRY_ENABLED=true
FEMA_TEMPLATES_SOURCE_URL="https://cloud.activepieces.com/api/v1/flow-templates"

## Tool-search engine — semantic action/trigger discovery for the MCP (default off).
FEMA_TOOL_SEARCH_ENABLED=false
## OpenAI API key that funds ALL tool-search embedding (catalog backfill, reindex on new pieces, and
## search queries) when tool-search is enabled. If unset, tool-search falls back to each platform's
## configured OpenAI provider key, then to keyword-only search. Only used when FEMA_TOOL_SEARCH_ENABLED=true.
FEMA_OPENAI_API_KEY=
